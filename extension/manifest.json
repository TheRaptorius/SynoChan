{
  "manifest_version": 3,
  "name": "SynoChan",
  "short_name": "SynoChan",
  "version": "0.0.0",
  "description": "Send 4chan threads and boards to SynoChan on your Synology NAS with a right click.",
  "homepage_url": "https://github.com/TheRaptorius/SynoChan",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "SynoChan",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["contextMenus", "storage", "notifications", "alarms", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "add-current-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Add the current thread or board to SynoChan"
    }
  }
}
