package="synochan"
version="@VERSION@"
os_min_ver="7.2-64551"
displayname="SynoChan"
description="Archives 4chan threads and boards to your NAS. Tracks threads until they are archived, saves every file as it is posted, and can follow whole boards for new threads."
maintainer="@MAINTAINER@"
maintainer_url="@REPO_URL@"
distributor="@MAINTAINER@"
distributor_url="@REPO_URL@"
support_url="@REPO_URL@/issues"
helpurl="@REPO_URL@#readme"
arch="noarch"
dsmuidir="ui"
dsmappname="SYNO.SDS.SynoChan.Application"
thirdparty="yes"
ctl_stop="yes"
silent_upgrade="yes"
changelog="@CHANGELOG@"
